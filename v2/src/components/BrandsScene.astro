---
// Brands signature: a full-bleed film that pushes in very slowly while two sage bars open like
// a letterbox. The calmest tempo on the page. At rest (and with reduced motion) the bars are
// already open and the frame is still.
//
// The film is public/media/brands.webm and brands.mp4, with brands-poster.webp as its poster
// (see README: video). Until those exist, the frame shows the `brands` photograph or its
// placeholder. Files over Cloudflare's 25 MiB limit are served from PUBLIC_MEDIA_BASE_URL.
import { existsSync } from "node:fs";
import path from "node:path";
import { COPY, type World } from "../lib/content";
import { MEDIA_BASE_URL } from "../lib/site";
import Media from "./Media.astro";

interface Props {
  world: World;
}

const { world } = Astro.props;
const local = (file: string) => existsSync(path.join(process.cwd(), "public/media", file));
const sources = [
  { type: "video/webm", file: "brands.webm" },
  { type: "video/mp4", file: "brands.mp4" },
]
  .filter(({ file }) => MEDIA_BASE_URL || local(file))
  .map(({ type, file }) => ({ type, src: `${MEDIA_BASE_URL}/media/${file}` }));
const poster = local("brands-poster.webp") ? "/media/brands-poster.webp" : undefined;
---

<div
  data-brands
  class="relative mr-[calc(var(--bleed)*-1)] overflow-clip @max-4xl:ml-[calc(var(--bleed)*-1)]"
>
  <div data-push>
    {sources.length ? (
      <div class="relative aspect-[4/5] max-h-[76svh] w-full bg-arena">
        {/* The sources are attached by the script below, only when the film is about to be seen. */}
        <video
          muted
          loop
          playsinline
          preload="none"
          poster={poster}
          aria-label={world.media.shot}
          data-sources={JSON.stringify(sources)}
          class="size-full object-cover"
        />
        <button
          type="button"
          data-film-toggle
          data-play={COPY.film.play}
          data-pause={COPY.film.pause}
          aria-label={COPY.film.play}
          class="group absolute right-4 bottom-4 grid size-11 place-items-center rounded-pill bg-cream text-chocolate transition-transform duration-(--duration-micro) active:scale-[0.94]"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path
              class="group-data-playing:hidden"
              d="M8 5.5v13l10.5-6.5L8 5.5z"
              fill="currentColor"
            />
            <path
              class="hidden group-data-playing:block"
              d="M8.5 5.5v13M15.5 5.5v13"
              stroke="currentColor"
              stroke-width="2.6"
              stroke-linecap="round"
            />
          </svg>
        </button>
      </div>
    ) : (
      <Media
        photo={world.media.key}
        shot={world.media.shot}
        sizes="(min-width: 64rem) 55vw, 100vw"
        class="max-h-[76svh] w-full"
      />
    )}
  </div>
  <span
    data-bar
    aria-hidden="true"
    class="absolute inset-x-0 top-0 h-[18%] origin-top scale-y-0 bg-accent"
  ></span>
  <span
    data-bar
    aria-hidden="true"
    class="absolute inset-x-0 bottom-0 h-[18%] origin-bottom scale-y-0 bg-accent"
  ></span>
</div>

<script>
  import { canAutoplay, scrollScene, watchVisibility, whenNear } from "../lib/client";

  const root = document.querySelector<HTMLElement>("[data-brands]");

  // Very slow, linear, cinematic: the Brands tempo.
  scrollScene(root, ({ gsap }, scene) => {
    gsap.fromTo(
      scene.querySelectorAll("[data-bar]"),
      { scaleY: 1 },
      {
        scaleY: 0,
        ease: "power1.inOut",
        scrollTrigger: { trigger: scene, start: "top 85%", end: "top 20%", scrub: 1.5 },
      },
    );
    gsap.fromTo(
      scene.querySelector("[data-push]"),
      { scale: 1 },
      {
        scale: 1.1,
        ease: "none",
        scrollTrigger: { trigger: scene, start: "top bottom", end: "bottom top", scrub: 1.5 },
      },
    );
  });

  // The film: nothing but the poster is fetched until it is near the viewport. It plays only
  // while visible, never on data-saver connections or with reduced motion, and the visitor
  // can always pause it.
  const video = root?.querySelector("video");
  const toggle = root?.querySelector<HTMLButtonElement>("[data-film-toggle]");
  if (video && toggle) {
    let pausedByVisitor = false;
    const sync = () => {
      toggle.toggleAttribute("data-playing", !video.paused);
      toggle.setAttribute(
        "aria-label",
        (video.paused ? toggle.dataset.play : toggle.dataset.pause) ?? "",
      );
    };
    video.addEventListener("play", sync);
    video.addEventListener("pause", sync);

    const attach = () => {
      if (video.childElementCount) return;
      for (const { type, src } of JSON.parse(video.dataset.sources ?? "[]")) {
        video.append(Object.assign(document.createElement("source"), { type, src }));
      }
      video.load();
    };
    whenNear(
      video,
      () => {
        attach();
        if (!canAutoplay()) return;
        watchVisibility(video, (visible) => {
          if (visible && !pausedByVisitor) void video.play().catch(() => {});
          else video.pause();
        });
      },
      "60% 0px",
    );

    toggle.addEventListener("click", () => {
      attach();
      pausedByVisitor = !video.paused;
      if (video.paused) void video.play().catch(() => {});
      else video.pause();
    });
  }
</script>
