---
// Choose, make, remember. The section opens with the same star-warp as the worlds, this time
// from the last world back onto the page's cream ground. The three steps are a real sequence,
// so they are numbered, and they are told by the thing the studio makes: a thread runs across
// the section and gathers one piece, then three, then the finished charm with its star. The
// thread draws itself and the pieces land on it as the section arrives; that is its one moment.
import { COPY, WORLDS } from "../lib/content";
import OpeningCard from "./OpeningCard.astro";
import Star from "./Star.astro";
import Wash from "./Wash.astro";

// Pieces as seen from the side, strung in this order. `along` and `across` are sizes relative
// to the thread's direction, in units of --u, so one list serves the row and the column.
const PIECES = [
  { colour: "bg-lavender", along: 1, across: 1, radius: "9999px" },
  { colour: "bg-rosa", along: 0.34, across: 0.86, radius: "9999px" },
  { colour: "bg-peach", along: 0.78, across: 0.78, radius: "26%" },
  { colour: "bg-blue", along: 0.56, across: 0.56, radius: "9999px" },
] as const;

// How many pieces are on the thread at each step. The last step also carries the star.
const PIECES_AT_STEP = [1, 3, PIECES.length];
const lastStep = COPY.how.steps.length - 1;
// Pieces are numbered across the whole thread, so they land one after another, and each knows
// roughly how far across the page it sits (three columns, a few pieces deep).
const order = (step: number, piece: number) =>
  PIECES_AT_STEP.slice(0, step).reduce((sum, count) => sum + count, 0) + piece;
const placing = (step: number, piece: number) =>
  `--i:${order(step, piece)};--at:${(0.06 + step * 0.31 + piece * 0.035).toFixed(3)}`;
---

<section aria-labelledby="como-funciona-titulo" class="relative">
  <OpeningCard from={WORLDS.at(-1)?.id} anchor="como-funciona" overNavigator>
    <Wash set="how-card" fade="both" />
    <div class="shell flex flex-col justify-end pt-(--section) pb-[clamp(72px,12svh,144px)]">
      <h2 id="como-funciona-titulo" class="text-display">
        {COPY.how.heading}
      </h2>
    </div>
  </OpeningCard>

  <div class="relative isolate overflow-x-clip bg-ground text-ink">
    <Wash set="how" fade="both" />
    <div class="shell pb-(--section)">
      <div class="strand">
        <div aria-hidden="true" data-scroll="draw" class="thread bg-ink"></div>
        <ol role="list" class="steps">
          {COPY.how.steps.map((step, index) => (
            <li class="step">
              <div aria-hidden="true" class="pieces">
                {PIECES.slice(0, PIECES_AT_STEP[index]).map((piece, position) => (
                  <span
                    class:list={["piece", piece.colour]}
                    style={`--along:${piece.along};--across:${piece.across};${placing(index, position)};border-radius:${piece.radius}`}
                  />
                ))}
                {index === lastStep && (
                  <span class="piece charm" style={placing(index, PIECES.length)}>
                    <Star class="h-full" />
                  </span>
                )}
              </div>
              <div>
                <span aria-hidden="true" class="font-display text-title text-ink-muted">
                  {index + 1}
                </span>
                <h3 class="mt-2 text-headline lg:mt-4">{step.title}</h3>
                <p class="mt-3 max-w-[24rem] text-lead text-ink-muted">{step.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  /*
   * On phones the thread hangs down the left and the steps stack beside it. From 64rem it runs
   * across the page, edge to edge, with the steps below it in three columns.
   */
  .strand {
    --u: 40px;
    /* The lane the pieces sit in: as deep as the star, the largest piece. */
    --lane: calc(var(--u) * 1.5);
    position: relative;
    padding-top: 8px;
  }

  .thread {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--lane) / 2);
    width: 1.5px;
  }

  .steps {
    position: relative;
    display: grid;
    row-gap: 56px;
  }

  .step {
    display: grid;
    grid-template-columns: var(--lane) 1fr;
    column-gap: 24px;
    align-items: start;
  }

  .pieces {
    display: flex;
    flex-direction: column;
    gap: 3px;
    align-items: center;
    /* A contact shadow, as under anything on the page that could be picked up. */
    filter: drop-shadow(0 10px 10px rgb(76 64 57 / 0.22));
  }

  .piece {
    display: block;
    flex: none;
    width: calc(var(--u) * var(--across));
    height: calc(var(--u) * var(--along));
  }

  .charm {
    width: auto;
    height: var(--lane);
  }

  @media (width >= 64rem) {
    .strand {
      --u: clamp(56px, 5.6vw, 84px);
      padding-top: 0;
    }

    .thread {
      top: calc(var(--lane) / 2);
      right: calc(var(--bleed) * -1);
      bottom: auto;
      left: calc(var(--bleed) * -1);
      width: auto;
      height: 1.5px;
    }

    .steps {
      grid-template-columns: repeat(3, 1fr);
      column-gap: 48px;
    }

    .step {
      grid-template-rows: var(--lane) auto;
      grid-template-columns: none;
      row-gap: 40px;
    }

    .pieces {
      flex-direction: row;
      height: var(--lane);
    }

    .piece {
      width: calc(var(--u) * var(--along));
      height: calc(var(--u) * var(--across));
    }

    .charm {
      width: auto;
      height: var(--lane);
    }
  }

  @keyframes thread-down {
    from {
      scale: 1 0;
    }
    to {
      scale: 1 1;
    }
  }

  @keyframes piece-land {
    from {
      scale: 0;
    }
    to {
      scale: 1;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports ((animation-timeline: view()) and (animation-range: entry)) {
      /* On phones each piece lands as it rises into view, a beat after the one before it. */
      .piece {
        animation: piece-land var(--ease-snap) both;
        animation-timeline: view();
        animation-range: cover calc(5% + var(--i) * 2.2%) cover calc(17% + var(--i) * 2.2%);
      }

      /* The shared draw primitive runs left to right; on phones the thread runs downward. */
      @media (width < 64rem) {
        .thread {
          transform-origin: center top;
          animation-name: thread-down;
          animation-range: entry 0% cover 55%;
        }
      }

      /*
       * Across the page, thread and pieces share one timeline, so a piece lands as the thread
       * reaches it. --at is roughly how far across the viewport the piece sits.
       */
      @media (width >= 64rem) {
        .strand {
          --draw: 42%;
          view-timeline: --strand block;
        }

        .thread {
          animation-timeline: --strand;
          animation-range: cover 0% cover var(--draw);
        }

        .piece {
          animation-timeline: --strand;
          animation-range: cover calc(var(--draw) * var(--at)) cover
            calc(var(--draw) * var(--at) + 7%);
        }
      }
    }
  }
</style>
