---
// Choose, make, remember. The section opens with the same star-warp as the worlds, this time
// from the last world back onto the page's cream ground. The three steps are a real sequence,
// so they are numbered, and they are told by the thing the studio makes, in the same bead
// language as the closing necklace: loose beads waiting to be chosen, beads strung on the
// thread, then the finished charm with its star. The thread draws itself and the beads drop
// onto it as the section arrives; that is its one moment.
import { COPY, WORLDS } from "../lib/content";
import OpeningCard from "./OpeningCard.astro";
import Star from "./Star.astro";
import Wash from "./Wash.astro";

// Bead shapes seen from the side: length along the thread, thickness across it, in units of
// --u, so one list serves the row (desktop) and the column (phones).
const SHAPES = {
  round: { along: 0.9, across: 0.9, radius: "9999px" },
  cube: { along: 0.7, across: 0.7, radius: "24%" },
  tube: { along: 1.05, across: 0.56, radius: "0.28em" },
  seed: { along: 0.26, across: 0.26, radius: "9999px" },
  spacer: { along: 0.12, across: 0.78, radius: "9999px" },
} as const;
type Shape = keyof typeof SHAPES;

// What lies on each step. Step one is loose beads, not yet strung (choosing); step two is beads
// on the thread (making); step three is the finished piece, with gold spacers and the star.
const STEPS: { loose?: boolean; star?: boolean; beads: [Shape, string][] }[] = [
  {
    loose: true,
    beads: [
      ["round", "bg-lavender"],
      ["cube", "bg-peach"],
      ["round", "bg-rosa"],
    ],
  },
  {
    beads: [
      ["seed", "bg-chocolate"],
      ["round", "bg-lavender"],
      ["tube", "bg-sage"],
      ["round", "bg-rosa"],
      ["seed", "bg-chocolate"],
    ],
  },
  {
    star: true,
    beads: [
      ["seed", "bg-chocolate"],
      ["cube", "bg-peach"],
      ["seed", "bg-chocolate"],
      ["round", "bg-blue"],
      ["spacer", "bg-gold"],
      ["round", "bg-lavender"],
      ["spacer", "bg-gold"],
    ],
  },
];

// Beads are numbered across the whole thread, so they land one after another, and each knows
// roughly how far across the page it sits (three columns, a few beads deep).
const order = (step: number, bead: number) =>
  STEPS.slice(0, step).reduce((sum, { beads }) => sum + beads.length, 0) + bead;
const placing = (step: number, bead: number) =>
  `--i:${order(step, bead)};--at:${(0.06 + step * 0.31 + bead * 0.03).toFixed(3)}`;
---

<section aria-labelledby="como-funciona-titulo" class="pointer-events-none relative">
  <OpeningCard from={WORLDS.at(-1)?.id} anchor="como-funciona" overNavigator>
    <Wash set="how-card" fade="both" />
    <div class="shell flex flex-col justify-end pt-(--section) pb-[clamp(72px,12svh,144px)]">
      <h2 id="como-funciona-titulo" class="text-display">
        {COPY.how.heading}
      </h2>
    </div>
  </OpeningCard>

  <div class="pointer-events-auto relative isolate overflow-x-clip bg-ground text-ink">
    <Wash set="how" fade="both" />
    <div class="shell pb-(--section)">
      <div class="strand">
        <div aria-hidden="true" data-scroll="draw" class="thread bg-ink"></div>
        <ol role="list" class="steps">
          {COPY.how.steps.map((step, index) => {
            const { loose, star, beads } = STEPS[index]!;
            return (
              <li class="step">
                <div aria-hidden="true" class:list={["beads", loose && "loose"]}>
                  {beads.map(([shape, colour], position) => (
                    <span
                      class:list={["bead", shape, colour]}
                      style={`--along:${SHAPES[shape].along};--across:${SHAPES[shape].across};--tilt:${(position % 2 ? 1 : -1) * (8 + position * 5)}deg;border-radius:${SHAPES[shape].radius};${placing(index, position)}`}
                    />
                  ))}
                  {star && (
                    <span class="bead charm" style={placing(index, beads.length)}>
                      <Star class="h-full" />
                    </span>
                  )}
                </div>
                <div>
                  <span aria-hidden="true" class="font-display text-title text-ink-muted">
                    {index + 1}
                  </span>
                  <h3 class="mt-2 text-headline lg:mt-4">{step.title}</h3>
                  <p class="mt-3 max-w-[24rem] text-lead text-ink-muted">{step.text}</p>
                </div>
              </li>
            );
          })}
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  /*
   * On phones the thread hangs down the left and the steps stack beside it. From 64rem it runs
   * across the page, edge to edge, with the steps below it in three columns.
   */
  .strand {
    --u: 40px;
    /* The lane the beads sit in: as deep as the star, the largest piece. */
    --lane: calc(var(--u) * 1.5);
    /* Which way a bead drops onto the thread: from the side on phones, from above on desktop. */
    --drop: -0.6em 0;
    position: relative;
    padding-top: 8px;
  }

  .thread {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--lane) / 2);
    width: 1.5px;
  }

  .steps {
    position: relative;
    display: grid;
    row-gap: 56px;
  }

  .step {
    display: grid;
    grid-template-columns: var(--lane) 1fr;
    column-gap: 24px;
    align-items: start;
  }

  .beads {
    display: flex;
    flex-direction: column;
    gap: 3px;
    align-items: center;
    /* A soft contact shadow, as under anything on the page that could be picked up. */
    filter: drop-shadow(0 6px 8px rgb(76 64 57 / 0.16));
  }

  .bead {
    position: relative;
    display: block;
    flex: none;
    width: calc(var(--u) * var(--across));
    height: calc(var(--u) * var(--along));
  }

  /* The same small highlight as the necklace's beads, lit from the top left. */
  .bead:not(.seed, .charm)::after {
    position: absolute;
    top: 16%;
    left: 18%;
    width: max(3px, 22%);
    aspect-ratio: 1;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.38);
    content: "";
  }

  .spacer::after {
    background: rgb(255 255 255 / 0.5);
  }

  /* Step one: not strung yet. The beads sit on the thread, spaced out and a little turned. */
  .loose {
    gap: 10px;
  }

  .loose .bead {
    transform: rotate(var(--tilt));
  }

  .charm {
    width: auto;
    height: var(--lane);
  }

  @media (width >= 64rem) {
    .strand {
      --u: clamp(52px, 4.4vw, 68px);
      --drop: 0 -0.6em;
      padding-top: 0;
    }

    .thread {
      top: calc(var(--lane) / 2);
      right: calc(var(--bleed) * -1);
      bottom: auto;
      left: calc(var(--bleed) * -1);
      width: auto;
      height: 1.5px;
    }

    .steps {
      grid-template-columns: repeat(3, 1fr);
      column-gap: 48px;
    }

    .step {
      grid-template-rows: var(--lane) auto;
      grid-template-columns: none;
      row-gap: 40px;
    }

    .beads {
      flex-direction: row;
      height: var(--lane);
    }

    .loose {
      gap: 14px;
    }

    .bead {
      width: calc(var(--u) * var(--along));
      height: calc(var(--u) * var(--across));
    }

    .charm {
      width: auto;
      height: var(--lane);
    }
  }

  @keyframes thread-down {
    from {
      scale: 1 0;
    }
    to {
      scale: 1 1;
    }
  }

  /* A bead drops onto the thread: it comes from just off it, already visible, never from nothing. */
  @keyframes bead-land {
    from {
      opacity: 0;
      scale: 0.7;
      translate: var(--drop);
    }
    to {
      opacity: 1;
      scale: 1;
      translate: 0 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports ((animation-timeline: view()) and (animation-range: entry)) {
      /* On phones each bead lands as it rises into view, a beat after the one before it. */
      .bead {
        font-size: var(--u);
        animation: bead-land var(--ease-snap) both;
        animation-timeline: view();
        animation-range: cover calc(5% + var(--i) * 2%) cover calc(16% + var(--i) * 2%);
      }

      /* The shared draw primitive runs left to right; on phones the thread runs downward. */
      @media (width < 64rem) {
        .thread {
          transform-origin: center top;
          animation-name: thread-down;
          animation-range: entry 0% cover 55%;
        }
      }

      /*
       * Across the page, thread and beads share one timeline, so a bead lands as the thread
       * reaches it. --at is roughly how far across the viewport the bead sits.
       */
      @media (width >= 64rem) {
        .strand {
          --draw: 42%;
          view-timeline: --strand block;
        }

        .thread {
          animation-timeline: --strand;
          animation-range: cover 0% cover var(--draw);
        }

        .bead {
          animation-timeline: --strand;
          animation-range: cover calc(var(--draw) * var(--at)) cover
            calc(var(--draw) * var(--at) + 7%);
        }
      }
    }
  }
</style>
