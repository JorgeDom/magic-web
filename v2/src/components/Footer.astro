---
// Chocolate ground: the monochrome logo from the brand book, then how to reach the studio.
// The city only, never a street address.
import { Image } from "astro:assets";
import monoLogo from "../assets/logo/mono.png";
import { COPY } from "../lib/content";
import { SITE, whatsappUrl } from "../lib/site";
import Icon from "./Icon.astro";

const heading = "border-t border-hairline pt-5 font-sans text-label text-ink-muted";
const channel =
  "group mt-3 inline-flex min-h-11 items-center gap-3 underline-offset-4 hover:underline";
// The icon sits in a ring that fills on hover, like the quiet button.
const ring =
  "grid size-11 place-items-center rounded-pill border-[1.5px] border-ink/40 transition-[background-color,border-color,color] duration-(--duration-micro) group-hover:border-ink group-hover:bg-ink group-hover:text-on-ink";
---

<footer data-ground="chocolate" class="deferred bg-ground text-ink">
  <div class="shell pt-(--section) pb-10">
    <Image
      src={monoLogo}
      alt={SITE.name}
      width={544}
      loading="lazy"
      class="h-auto w-[min(60vw,17rem)]"
    />
    <div class="mt-14 grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:mt-20 lg:grid-cols-3">
      <div>
        <h3 class={heading}>{COPY.footer.write}</h3>
        <a
          href={whatsappUrl(COPY.footer.message)}
          target="_blank"
          rel="noopener noreferrer"
          class={channel}
        >
          <span class={ring}>
            <Icon name="whatsapp" />
          </span>
          <span>
            <span class="sr-only">WhatsApp&nbsp;</span>
            {SITE.whatsapp.display}
          </span>
          <span class="sr-only">&nbsp;{COPY.newTab}</span>
        </a>
      </div>
      <div>
        <h3 class={heading}>{COPY.footer.follow}</h3>
        <a href={SITE.instagram.url} target="_blank" rel="noopener noreferrer" class={channel}>
          <span class={ring}>
            <Icon name="instagram" />
          </span>
          <span>
            <span class="sr-only">Instagram&nbsp;</span>@{SITE.instagram.handle}
          </span>
          <span class="sr-only">&nbsp;{COPY.newTab}</span>
        </a>
      </div>
      <div>
        <h3 class={heading}>{COPY.footer.where}</h3>
        <p class="mt-3 flex min-h-11 items-center">
          {SITE.location.city}, {SITE.location.country}
        </p>
      </div>
    </div>
    {/* The legal notice (pages/_legal.astro) is not published yet; link it here when it is. */}
    <p class="mt-16 text-label font-normal text-ink-muted">
      © {new Date().getFullYear()}
      {SITE.name}. {COPY.footer.rights}
    </p>
  </div>
</footer>
