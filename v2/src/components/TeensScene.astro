---
// Teens signature: charm straps, the kind that hang from a phone or a bag, clipped to the
// corners of the photographs. They swing with the speed of the scroll and settle with a quick,
// springy overshoot. With a mouse they can be pulled and let go; on touch a tap sets one
// swinging (dragging would fight the page scroll). They are made in the same bead language as
// the closing necklace, in the Teens colours only: lavender, cream and chocolate on peach,
// with gold for the findings.
import type { World } from "../lib/content";
import Gallery from "./Gallery.astro";

interface Props {
  world: World;
}

const { world } = Astro.props;

// A strap, top to bottom. Lengths are in units of --u. Letter cubes spell the studio's name.
type Piece =
  | { kind: "cord"; length: number }
  | { kind: "seed" }
  | { kind: "spacer" }
  | { kind: "round" | "tube" | "drop"; colour: string }
  | { kind: "cube"; letter: string };

const letters = (word: string): Piece[] => [...word].map((letter) => ({ kind: "cube", letter }));

const STRAPS: { place: string; weight: number; pieces: Piece[] }[] = [
  {
    // Clipped to the top left corner of the first photograph.
    place: "corner",
    weight: 1,
    pieces: [
      { kind: "cord", length: 1.5 },
      { kind: "seed" },
      { kind: "round", colour: "bg-lavender" },
      { kind: "spacer" },
      ...letters("magic"),
      { kind: "spacer" },
      { kind: "round", colour: "bg-cream" },
      { kind: "seed" },
      { kind: "cord", length: 0.45 },
      { kind: "drop", colour: "bg-lavender" },
    ],
  },
  {
    // A shorter one on the far corner, where the spread has room for it.
    place: "far",
    weight: 0.75,
    pieces: [
      { kind: "cord", length: 1 },
      { kind: "seed" },
      { kind: "round", colour: "bg-cream" },
      { kind: "tube", colour: "bg-lavender" },
      { kind: "round", colour: "bg-cream" },
      { kind: "seed" },
      { kind: "cord", length: 0.4 },
      { kind: "drop", colour: "bg-cream" },
    ],
  },
];
---

<div class="relative">
  <Gallery base={world.media.key} shot={world.media.shot} label={`Fotos de ${world.name}`} />
  <div data-charms aria-hidden="true" class="straps">
    {STRAPS.map((strap) => (
      <div data-pull class:list={["pull", strap.place]}>
        <div data-charm data-weight={strap.weight} class="strap">
          <span class="ring" />
          {strap.pieces.map((piece) =>
            piece.kind === "cord" ? (
              <span class="cord" style={`--length:${piece.length}`} />
            ) : piece.kind === "cube" ? (
              <span class="bead cube bg-cream">{piece.letter}</span>
            ) : piece.kind === "seed" ? (
              <span class="bead seed bg-chocolate" />
            ) : piece.kind === "spacer" ? (
              <span class="bead spacer bg-gold" />
            ) : (
              <span class:list={["bead", piece.kind, piece.colour]} />
            ),
          )}
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .straps {
    --u: 16px;
    position: absolute;
    inset: 0;
    /* A container, so the far strap can find the corner of the lowered column (cqw). */
    container-type: inline-size;
    pointer-events: none;
  }

  /* The ring sits on the photograph's corner; the strap hangs down along its edge. */
  .pull {
    position: absolute;
    top: 0;
    left: 0;
    translate: -50% calc(var(--u) * -0.4);
    pointer-events: auto;
    touch-action: manipulation;
  }

  /* Phones show the photographs as one row, so there is one corner and one strap. */
  .far {
    display: none;
  }

  .strap {
    display: flex;
    flex-direction: column;
    gap: 2px;
    align-items: center;
    transform-origin: center top;
    /* A soft contact shadow, as under anything on the page that could be picked up. */
    filter: drop-shadow(0 6px 8px rgb(76 64 57 / 0.2));
  }

  .ring {
    width: calc(var(--u) * 0.8);
    aspect-ratio: 1;
    border: 2px solid var(--color-gold);
    border-radius: 9999px;
  }

  .cord {
    width: 1.5px;
    height: calc(var(--u) * var(--length));
    margin-block: -2px;
    background: var(--color-chocolate);
  }

  .bead {
    position: relative;
    display: block;
    flex: none;
    width: calc(var(--u) * 0.9);
    height: calc(var(--u) * 0.9);
    border-radius: 9999px;
  }

  .seed {
    width: calc(var(--u) * 0.3);
    height: calc(var(--u) * 0.3);
  }

  .spacer {
    width: calc(var(--u) * 0.8);
    height: calc(var(--u) * 0.14);
  }

  .tube {
    width: calc(var(--u) * 0.58);
    height: calc(var(--u) * 1.1);
    border-radius: calc(var(--u) * 0.26);
  }

  /* A letter bead: a cream cube with its letter pressed in. */
  .cube {
    display: grid;
    width: calc(var(--u) * 0.92);
    height: calc(var(--u) * 0.92);
    place-items: center;
    border-radius: 24%;
    color: var(--color-chocolate);
    font-family: var(--font-display);
    font-size: calc(var(--u) * 0.62);
    font-weight: 600;
    line-height: 1;
  }

  /* A teardrop, point up, hanging from the last cord. */
  .drop {
    width: calc(var(--u) * 0.95);
    height: calc(var(--u) * 0.95);
    margin-top: calc(var(--u) * 0.12);
    border-radius: 0 50% 50% 50%;
    rotate: 45deg;
  }

  /* The same small highlight as the necklace's beads, lit from the top left. */
  .round::after,
  .tube::after {
    position: absolute;
    top: 16%;
    left: 18%;
    width: max(3px, 22%);
    aspect-ratio: 1;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.42);
    content: "";
  }

  @media (width >= 64rem) {
    .straps {
      --u: clamp(20px, 1.75vw, 25px);
    }

    /* The second column of photographs is set lower (see Gallery); this is its top right. */
    .far {
      top: calc((100cqw - 16px) * 0.0875);
      right: 0;
      left: auto;
      display: block;
      translate: 50% calc(var(--u) * -0.4);
    }
  }
</style>

<script>
  import { finePointer, scrollScene } from "../lib/client";

  const MAX_SWING = 18; // degrees
  const SETTLE = { rotation: 0, duration: 1.5, ease: "elastic.out(1, 0.26)", overwrite: true };

  scrollScene(
    document.querySelector<HTMLElement>("[data-charms]"),
    ({ gsap, ScrollTrigger }, root) => {
      const charms = gsap.utils.toArray<HTMLElement>("[data-charm]", root);

      // Swing with scroll velocity; settle a moment after scrolling stops.
      const settle = gsap
        .delayedCall(0.1, () => gsap.to(charms, { ...SETTLE, stagger: 0.04 }))
        .pause();
      ScrollTrigger.create({
        trigger: root,
        start: "top bottom",
        end: "bottom top",
        onUpdate(self) {
          const swing = gsap.utils.clamp(-MAX_SWING, MAX_SWING, self.getVelocity() / -150);
          for (const charm of charms) {
            gsap.to(charm, {
              rotation: swing * Number(charm.dataset.weight),
              duration: 0.36,
              ease: "power2.out",
              overwrite: true,
            });
          }
          settle.restart(true);
        },
      });

      for (const pull of gsap.utils.toArray<HTMLElement>("[data-pull]", root)) {
        const charm = pull.querySelector<HTMLElement>("[data-charm]");
        if (!finePointer()) {
          // Touch: a tap sets the charm swinging.
          pull.addEventListener("pointerdown", () => gsap.fromTo(charm, { rotation: 14 }, SETTLE));
          continue;
        }
        // Mouse: pull the charm, let go, and it snaps back with an overshoot.
        pull.style.cursor = "grab";
        pull.addEventListener("pointerdown", (down) => {
          pull.setPointerCapture(down.pointerId);
          pull.style.cursor = "grabbing";
          const move = (event: PointerEvent) =>
            gsap.set(pull, {
              x: (event.clientX - down.clientX) * 0.6,
              y: (event.clientY - down.clientY) * 0.6,
            });
          const release = () => {
            pull.removeEventListener("pointermove", move);
            pull.style.cursor = "grab";
            gsap.to(pull, { x: 0, y: 0, duration: 0.9, ease: "elastic.out(1, 0.4)" });
          };
          pull.addEventListener("pointermove", move);
          pull.addEventListener("pointerup", release, { once: true });
          pull.addEventListener("pointercancel", release, { once: true });
        });
      }
    },
  );
</script>
