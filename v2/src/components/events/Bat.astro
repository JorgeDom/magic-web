---
// A bat, for Halloween. In flight its wings beat; `hanging` is the same animal asleep, upside
// down with its wings wrapped round it. It takes the colour of the text around it
// (currentColor); size it with a height utility or from a wrapper.
interface Props {
  hanging?: boolean;
  class?: string;
}

const { hanging = false, class: className } = Astro.props;

// One wing, attached at the shoulder (64, 28); the other is its mirror image.
const WING = "M64 26C76 12 98 10 116 20c-6 2-10 7-11 13-6-4-12-3-15 3-5-5-11-4-14 2-4-4-9-4-12-2z";
---

{hanging ? (
  <svg
    viewBox="0 0 40 74"
    aria-hidden="true"
    focusable="false"
    class:list={["block aspect-[40/74] fill-current", className]}
  >
    <path d="M17 0h2v7h-2zm4 0h2v7h-2z" />
    <path d="M20 5C8 13 5 41 20 59c15-18 12-46 0-54z" />
    <circle cx="20" cy="59" r="7.6" />
    <path d="m14 62-1.6 10 6.2-5.4zm12 0 1.6 10-6.2-5.4z" />
    <circle cx="17.3" cy="59" r="1.3" class="eye" />
    <circle cx="22.7" cy="59" r="1.3" class="eye" />
  </svg>
) : (
  <svg
    viewBox="0 0 120 60"
    aria-hidden="true"
    focusable="false"
    class:list={["block aspect-[2/1] fill-current", className]}
  >
    <g class="wing">
      <path d={WING} />
    </g>
    <g transform="translate(120 0) scale(-1 1)">
      <g class="wing">
        <path d={WING} />
      </g>
    </g>
    <ellipse cx="60" cy="33" rx="6.5" ry="10.5" />
    <circle cx="60" cy="21" r="6.6" />
    <path d="m54.6 17.6-1-8.6 5.6 5zm10.8 0 1-8.6-5.6 5z" />
  </svg>
)}

<style>
  svg {
    overflow: visible;
  }

  .eye {
    fill: var(--bat-eye, var(--color-cream));
  }

  /* Each wing turns about its shoulder. */
  .wing {
    transform-box: view-box;
    transform-origin: 64px 28px;
  }

  @keyframes bat-flap {
    from {
      transform: rotate(-22deg);
    }
    to {
      transform: rotate(15deg);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .wing {
      animation: bat-flap var(--flap, 300ms) ease-in-out infinite alternate;
    }
  }
</style>
