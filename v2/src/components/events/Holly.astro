---
// A sprig of holly, for Navidad: two prickly leaves and three red berries where they meet.
// Size it by width or from a wrapper.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

// One leaf, from its stalk at 0, 0 to its tip at 56, 0, with three prickles a side.
const LEAF =
  "M0 0C8-10 14-4 20-11C24-3 32-6 38-12C41-3 50-5 56 0C50 5 41 3 38 12C32 6 24 3 20 11C14 4 8 10 0 0Z";
---

<svg
  viewBox="-60 -34 120 62"
  aria-hidden="true"
  focusable="false"
  class:list={["block aspect-[120/62]", className]}
>
  <g transform="rotate(-158)">
    <path d={LEAF} fill="#5c9474"></path>
    <path d="M4 0H50" fill="none" stroke="#3f7257" stroke-width="1.4" stroke-linecap="round"></path>
  </g>
  <g transform="rotate(-24)">
    <path d={LEAF} fill="#7fb08f"></path>
    <path d="M4 0H50" fill="none" stroke="#4f8769" stroke-width="1.4" stroke-linecap="round"></path>
  </g>
  <g fill="#d2635d">
    <circle cx="-6" cy="-3" r="6.6"></circle>
    <circle cx="6" cy="-2" r="6.6"></circle>
    <circle cx="0" cy="7" r="6.6"></circle>
  </g>
  {/* The same small highlight as the beads, on each berry. */}
  <g fill="rgb(255 255 255 / 0.6)">
    <circle cx="-8" cy="-5.2" r="1.6"></circle>
    <circle cx="4" cy="-4.2" r="1.6"></circle>
    <circle cx="-2" cy="4.8" r="1.6"></circle>
  </g>
</svg>
