---
// The snow on the Navidad page: it falls across the whole page, behind the content, for as
// long as the page is open. The layer is as tall as the screen and stays with it while the
// page scrolls (it is sticky inside its parent, and takes up no room). With reduced motion the
// flakes are simply scattered, still.
import Snowflake from "./Snowflake.astro";

// A small seeded generator, so the snow is the same on every visit and in every build.
let seed = 20261224;
const random = () => {
  seed = (seed + 0x6d2b79f5) | 0;
  let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};

const FLAKES = Array.from({ length: 38 }, (_, index) => {
  // Every sixth flake is a crystal, large enough to show its arms.
  const crystal = index % 6 === 0;
  const size = crystal ? 16 + random() * 12 : 4 + random() * 6;
  const seconds = (crystal ? 16 : 9) + random() * 9;
  return {
    crystal,
    style: [
      `--x:${(random() * 100).toFixed(1)}%`,
      `--y:${(random() * 100).toFixed(1)}%`,
      `--size:${size.toFixed(1)}px`,
      `--fall:${seconds.toFixed(1)}s`,
      // A negative delay starts each flake part of the way down, so the sky is full at once.
      `--wait:${(-random() * seconds).toFixed(1)}s`,
      `--drift:${((random() - 0.5) * 90).toFixed(0)}px`,
      // Kept soft: a flake passing behind a line of copy must not wash it out.
      `--dim:${(0.16 + random() * 0.14).toFixed(2)}`,
    ].join(";"),
  };
});
---

<div aria-hidden="true" class="snow">
  {FLAKES.map(({ crystal, style }) => (
    <span class:list={["flake", crystal && "crystal"]} style={style}>
      {crystal && <Snowflake class="h-full" />}
    </span>
  ))}
</div>

<style>
  .snow {
    position: sticky;
    top: 0;
    height: 100svh;
    margin-bottom: -100svh;
    /* Behind the copy and the photographs, in front of the ground and its wash. */
    z-index: -1;
    overflow: clip;
    pointer-events: none;
  }

  /* At rest (reduced motion): scattered over the screen. */
  .flake {
    position: absolute;
    top: var(--y);
    left: var(--x);
    width: var(--size);
    height: var(--size);
    border-radius: 9999px;
    background: var(--color-cream);
    color: var(--color-cream);
    opacity: var(--dim);
  }

  .crystal {
    border-radius: 0;
    background: none;
  }

  /* Down the screen, wandering a little from side to side on the way. */
  @keyframes snow-fall {
    0% {
      translate: 0 0;
    }
    25% {
      translate: calc(var(--drift) * 0.6) 29vh;
    }
    50% {
      translate: calc(var(--drift) * -0.2) 58vh;
    }
    75% {
      translate: calc(var(--drift) * 0.8) 87vh;
    }
    100% {
      translate: var(--drift) 116vh;
    }
  }

  @keyframes snow-turn {
    to {
      rotate: 1turn;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .flake {
      top: -8vh;
      animation: snow-fall var(--fall) linear var(--wait) infinite;
    }

    .crystal {
      animation:
        snow-fall var(--fall) linear var(--wait) infinite,
        snow-turn calc(var(--fall) * 1.3) linear infinite;
    }
  }
</style>
