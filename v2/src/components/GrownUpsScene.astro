---
// Grown Ups signature: an editorial spread. The photographs unveil behind a slow mask as they
// arrive, over a rosa sheet that drifts a little slower than the page. All of it is CSS
// scroll-driven (see global.css), so this scene ships no JavaScript.
import type { World } from "../lib/content";
import Gallery from "./Gallery.astro";

interface Props {
  world: World;
}

const { world } = Astro.props;
---

<div class="relative @4xl:pb-[6%] @4xl:pl-[6%]">
  <div
    aria-hidden="true"
    data-scroll="parallax"
    style="--parallax:32px"
    class="absolute bottom-0 left-0 hidden h-[40%] w-[44%] rounded-(--media-radius) bg-accent @4xl:block"
  ></div>
  <Gallery
    base={world.media.key}
    shot={world.media.shot}
    label={`Fotos de ${world.name}`}
    scroll="unveil"
  />
</div>
