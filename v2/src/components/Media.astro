---
// A fixed-ratio frame for a photograph, with the corner radius of whichever world it sits in.
// Photos live in src/assets/photos and are matched by file name; Astro produces AVIF and WebP
// at several widths at build time. Until a photo exists the frame shows a labelled Arena
// placeholder, so missing media is obvious instead of silently filled with invented imagery.
import { Picture } from "astro:assets";
import { PHOTO_ALT } from "../lib/content";
import { findPhoto } from "../lib/photos";
import { todo } from "../lib/site";

interface Props {
  /** File name in src/assets/photos, without extension. */
  photo: string;
  /** What the photograph shows. Used as alt text, and as the brief on the placeholder. */
  shot: string;
  /** How wide the frame is at each breakpoint (the `sizes` attribute). */
  sizes: string;
  /** Tailwind aspect-ratio utility. The box is reserved before the image loads. */
  aspect?: string;
  /** Scroll primitive applied to the frame (see global.css). */
  scroll?: "unveil";
  class?: string;
}

const { photo, shot, sizes, aspect = "aspect-[4/5]", scroll, class: className } = Astro.props;

const image = findPhoto(photo);
// Real photos are described by what they show (lib/content.ts); otherwise the brief stands in.
const alt = PHOTO_ALT[photo] ?? shot;
---

<div
  data-scroll={scroll}
  class:list={["relative overflow-clip rounded-(--media-radius) bg-arena", aspect, className]}
>
  {image ? (
    <Picture
      src={image}
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      widths={[480, 800, 1200, 1800].filter((width) => width <= image.width)}
      sizes={sizes}
      alt={alt}
      loading="lazy"
      decoding="async"
      class="size-full object-cover"
      pictureAttributes={{ class: "block size-full" }}
    />
  ) : (
    <p data-todo="photo" class="absolute inset-x-5 bottom-5 max-w-[22ch] text-label text-chocolate">
      {todo("Foto")}
      <span class="mt-1 block font-normal">{shot}</span>
    </p>
  )}
  <slot />
</div>
