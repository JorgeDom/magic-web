---
// The one button on the site: a pill link. Ink and on-ink invert by themselves on chocolate
// sections, so there is no "on dark" variant. Pass `whatsapp` (a prefilled message) for the
// booking action; every "Reservá" on the page opens WhatsApp this way.
import { COPY } from "../lib/content";
import { whatsappUrl } from "../lib/site";
import Icon from "./Icon.astro";

interface Props {
  href?: string;
  whatsapp?: string;
  variant?: "primary" | "quiet";
  size?: "regular" | "compact";
  class?: string;
}

const { whatsapp, variant = "primary", size = "regular", class: className } = Astro.props;
const href = whatsapp ? whatsappUrl(whatsapp) : (Astro.props.href ?? "#");
const external = href.startsWith("http");
---

<a
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  class:list={[
    "inline-flex items-center justify-center gap-2.5 rounded-pill font-sans text-body leading-none font-medium whitespace-nowrap select-none",
    "transition-[transform,background-color,color] duration-(--duration-micro) ease-out active:scale-[0.97]",
    variant === "primary"
      ? "bg-ink text-on-ink hover:bg-ink/88"
      : "border-[1.5px] border-ink text-ink hover:bg-ink hover:text-on-ink",
    size === "regular" ? "min-h-[52px] px-7" : "min-h-11 px-5",
    className,
  ]}
>
  {whatsapp && <Icon name="whatsapp" />}
  <slot />
  {external && <span class="sr-only">&nbsp;{COPY.newTab}</span>}
</a>
