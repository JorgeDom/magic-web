---
// A satin ribbon that runs across its box, edge to edge: a band in the date's soft colour with
// a fine sheen along it. The path is drawn in a 100 x 100 box that stretches to fit; the
// ribbon keeps its thickness (--ribbon) however the box is stretched. Position the box from
// the parent (wrap it), and let the path start and end just outside 0 and 100.
interface Props {
  d: string;
}

const { d } = Astro.props;
---

<span aria-hidden="true" class="ribbon">
  <svg viewBox="0 0 100 100" preserveAspectRatio="none" focusable="false">
    <path d={d} vector-effect="non-scaling-stroke" class="band"></path>
  </svg>
  <svg viewBox="0 0 100 100" preserveAspectRatio="none" focusable="false" class="over">
    <path d={d} vector-effect="non-scaling-stroke" class="sheen"></path>
  </svg>
</span>

<style>
  .ribbon {
    --ribbon: 16px;
    position: absolute;
    inset: 0;
    display: block;
    pointer-events: none;
  }

  svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  path {
    fill: none;
  }

  .band {
    stroke: var(--event-soft, var(--color-rosa));
    stroke-width: var(--ribbon);
  }

  /* The sheen rides a little above the band's middle, as light does on satin. */
  .over {
    translate: 0 calc(var(--ribbon) * -0.2);
  }

  .sheen {
    stroke: rgb(255 255 255 / 0.5);
    stroke-width: calc(var(--ribbon) * 0.14);
  }

  @media (width >= 64rem) {
    .ribbon {
      --ribbon: 24px;
    }
  }
</style>
