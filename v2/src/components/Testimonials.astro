---
// Two or three voices, set large. No cards, no avatars, no star ratings: the words carry it.
// Quotes are placeholders until the studio supplies real ones (see src/lib/content.ts).
import { COPY } from "../lib/content";
---

<section
  data-ground="mint"
  aria-labelledby="testimonios-titulo"
  class="deferred bg-ground text-ink"
>
  <div class="shell py-(--section)">
    <h2 id="testimonios-titulo" class="text-headline">
      {COPY.testimonials.heading}
    </h2>
    <ul role="list" class="mt-12 lg:mt-20">
      {COPY.testimonials.quotes.map((item) => (
        <li class="border-t border-hairline py-10 lg:py-14">
          <figure class="grid gap-6 lg:grid-cols-12 lg:gap-x-8">
            <blockquote class="font-display text-statement lg:col-span-8">
              <p>“{item.quote}”</p>
            </blockquote>
            <figcaption class="text-label text-ink-muted lg:col-span-3 lg:col-start-10 lg:pt-3">
              {item.by}
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>
