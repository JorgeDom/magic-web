# Copy to .env. Every value is optional; the site builds without any of them.
# PUBLIC_* values are inlined into the static build.

# Canonical origin, used for metadata, Open Graph and the sitemap.
PUBLIC_SITE_URL=https://magic.com.py

# Base URL for video too large for Cloudflare's 25 MiB per-file limit (a public R2 bucket).
# Leave empty to serve video from /media in this deployment.
PUBLIC_MEDIA_BASE_URL=

# Optional contact form (off by default). Any form service that accepts a JSON POST works.
PUBLIC_ENABLE_CONTACT_FORM=false
PUBLIC_FORM_ENDPOINT=
