{
  "name": "magic-web-v2",
  "version": "2.0.0",
  "private": true,
  "description": "MAgic! Creative Studio website, second iteration (Astro static build for Cloudflare)",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node check-limits.mjs",
    "preview": "wrangler dev",
    "deploy": "pnpm build && wrangler deploy",
    "typecheck": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "motion": "^14.0.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/three": "^0.186.0",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "wrangler": "^4.147.0"
  }
