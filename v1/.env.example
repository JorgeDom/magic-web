# Copy to .env.local. Every value is optional; the site builds without any of them.
# NEXT_PUBLIC_* values are inlined into the static bundle at build time.

# Canonical origin, used for metadata, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://magic.com.py

# Base URL for media too large for the 25 MiB per-file limit (a Cloudflare R2 public bucket).
# Leave empty to serve everything from /media in this deployment.
NEXT_PUBLIC_MEDIA_BASE_URL=

# Optional contact form (off by default). Any form service that accepts a JSON POST works.
NEXT_PUBLIC_ENABLE_CONTACT_FORM=false
NEXT_PUBLIC_FORM_ENDPOINT=
