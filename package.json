{
  "name": "magic-web",
  "version": "1.0.0",
  "private": true,
  "description": "MAgic! Creative Studio website (static export, Cloudflare Workers assets)",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "assets": "node scripts/build-brand-assets.mjs && node scripts/optimize-images.mjs",
    "prebuild": "pnpm assets",
    "build": "next build",
    "postbuild": "node scripts/check-limits.mjs",
    "preview": "wrangler dev",
    "deploy": "pnpm build && wrangler deploy",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "video": "node scripts/encode-video.mjs",
    "shots": "node scripts/screenshots.mjs"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@rive-app/react-canvas": "^4.36.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "motion": "^14.0.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.147.0"
  }
}
